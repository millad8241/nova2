{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6d527343-da75-4f8c-a185-d82eae4bc1e4","database_name": "nova-e9c0bf-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dc4da56723a541d6810f84c3e72d4739" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
